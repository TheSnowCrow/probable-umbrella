        <attribute name="createdAt" optional="NO" attributeType="Date" usesScalarValueType="NO"/>
        <relationship name="project" optional="NO" maxCount="1" deletionRule="Nullify" destinationEntity="QIProject" inverseName="entries" inverseEntity="QIProject"/>
    </entity>
</model>
